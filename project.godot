; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Fafavalley"
config/description="Jeu de ferme cosy en pixel art, pensé pour mobile."
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.png"
config/quit_on_go_back=false

[autoload]

InputSetup="*res://scripts/autoload/input_setup.gd"
EventBus="*res://scripts/autoload/event_bus.gd"
GameData="*res://scripts/autoload/game_data.gd"
TimeManager="*res://scripts/autoload/time_manager.gd"
Inventory="*res://scripts/autoload/inventory.gd"
FarmState="*res://scripts/autoload/farm_state.gd"
PlayerState="*res://scripts/autoload/player_state.gd"
Relations="*res://scripts/autoload/relations.gd"
FishLog="*res://scripts/autoload/fish_log.gd"
Crafting="*res://scripts/autoload/crafting.gd"
Settings="*res://scripts/autoload/settings.gd"
Sfx="*res://scripts/autoload/sfx.gd"
Skills="*res://scripts/autoload/skills.gd"
Mail="*res://scripts/autoload/mail.gd"
Forage="*res://scripts/autoload/forage.gd"
Animals="*res://scripts/autoload/animals.gd"
Shops="*res://scripts/autoload/shops.gd"
SaveManager="*res://scripts/autoload/save_manager.gd"
GameFlow="*res://scripts/autoload/game_flow.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=true

[rendering]

anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=2048

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
environment/defaults/default_clear_color=Color(0.16, 0.24, 0.14, 1)
